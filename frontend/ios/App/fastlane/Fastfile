default_platform(:ios)

platform :ios do
  desc "Build the app and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"],
      in_house: false
    )

    # Auto-pick the next build number: (highest build already on TestFlight) + 1.
    # This project isn't set up for Apple Generic Versioning (no
    # VERSIONING_SYSTEM in project.pbxproj), so agvtool / increment_build_number
    # don't apply -- instead we override CURRENT_PROJECT_VERSION at archive time
    # via xcargs. Info.plist's CFBundleVersion is $(CURRENT_PROJECT_VERSION), so
    # the value flows straight into the built binary. The number committed in
    # project.pbxproj is now just a fallback for local Xcode builds.
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "ie.automax.app",
      live: false,
      initial_build_number: 0
    ) + 1
    UI.important("Building as TestFlight build #{build_number}")

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        signingStyle: "manual",
        teamID: ENV["APPLE_TEAM_ID"],
        provisioningProfiles: {
          "ie.automax.app" => ENV["IOS_PROVISIONING_PROFILE_NAME"]
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
